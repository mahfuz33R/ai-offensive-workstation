# Copy this file to .env and replace the first four values for your computer.
# Both directories live under workspace so /root and /opt/data remain visible
# and recoverable from the host even if the image or container is removed.
# Docker Hermes never reads or modifies the host Hermes directory at
# $HOME/.hermes.
HERMES_DATA_DIR=/home/CHANGE_ME/ai-offensive-workstation/workspace/container-opt/data
WORKSTATION_ROOT_DIR=/home/CHANGE_ME/ai-offensive-workstation/workspace/container-root
HERMES_UID=1000
HERMES_GID=1000

HERMES_IMAGE=nousresearch/hermes-agent
HERMES_TAG=latest
# Optional: uncomment to pin an exact base image instead of following latest.
# HERMES_DIGEST=@sha256:45b67c84c5d7eef97746b576ad56ca7b21aa334396096415a6a98c5fd3a2d4a0
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable

# The dashboard binds to 127.0.0.1 on the Docker host.
# For remote servers, use SSH forwarding instead of exposing this publicly.
HERMES_DASHBOARD_PORT=9119
