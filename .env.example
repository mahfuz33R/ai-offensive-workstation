# AI Offensive Workstation — the only operator configuration template.
#
# Copy to .env, keep it mode 600, and never commit the resulting file:
#   cp .env.example .env
#   chmod 600 .env
#
# Docker Compose uses this file for both project interpolation and runtime
# credentials. It is excluded from Git and the Docker build context.

COMPOSE_PROJECT_NAME=ai-offensive-workstation

# Host persistence and ownership
HERMES_DATA_DIR=./workspace/container-opt/data
WORKSTATION_ROOT_DIR=./workspace/container-root
HERMES_UID=1000
HERMES_GID=1000

# Stable Kali and direct agent releases
KALI_IMAGE=kalilinux/kali-last-release
KALI_TAG=latest
KALI_DIGEST=
HERMES_VERSION=latest
CYBERSTRIKE_VERSION=latest

# Current language and browser toolchains
NODE_VERSION=latest
NPM_VERSION=latest
GO_VERSION=1.26.5
RUST_TOOLCHAIN=stable
PLAYWRIGHT_VERSION=1.62.0
AGENT_BROWSER_VERSION=latest

# Host-local service port
HERMES_DASHBOARD_PORT=9119

# Hermes OpenAI-compatible API. Compose fixes the internal bind to
# 0.0.0.0:8642 and publishes it only on host loopback. Generate a unique key:
#   openssl rand -hex 32
API_SERVER_KEY=

# Optional CyberStrike server authentication override. Leave blank to use a
# random process-only password; port 4096 remains container-loopback-only.
CYBERSTRIKE_SERVER_USERNAME=cyberstrike
CYBERSTRIKE_SERVER_PASSWORD=

# Optional security-tool credentials
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
VIRUSTOTAL_API_KEY=
INTERACTSH_AUTH_TOKEN=

# Optional Hermes/CyberStrike model providers. Configure only providers used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
