# The only private operator configuration file
.env

# Persistent workstation and authenticated agent state
workspace/
workspace.before-reuse-*/
.env.before-reuse-*

# Images, migration bundles, and generated offline exports
*.tar
*.tar.gz
*.tar.gpg
ai-offensive-workstation-offline-files/

# Test source under tests/ stays tracked; only generated test artifacts are ignored
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit.xml
test-results/
.test-results/

# OS/editor noise
.DS_Store
*.swp
*~

# Runtime audit and temporary migration state
.runtime-audit.*
.reuse-tmp.*
