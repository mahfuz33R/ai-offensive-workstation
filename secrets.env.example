#################################################################
# secrets.env.example
#
# This is a TEMPLATE. Copy it, don't edit it directly:
#
#   cp secrets.env.example secrets.env
#
# Then fill in your own real keys in secrets.env.
#
# secrets.env is loaded at CONTAINER RUNTIME ONLY (via `docker run
# --env-file`). It is never copied into the Docker image, so your
# keys never end up baked into a layer. secrets.env is listed in
# .gitignore and .dockerignore for the same reason - never commit
# it, never let `docker build` see it.
#################################################################

# Shodan (https://account.shodan.io/) - used by shodan CLI in
# the Shodan CLI
SHODAN_API_KEY=

# Censys (https://search.censys.io/account/api) - used by
# censys-subdomain-finder
CENSYS_API_ID=
CENSYS_API_SECRET=

# VirusTotal (https://www.virustotal.com/gui/my-apikey) - used by
# knockpy
VIRUSTOTAL_API_KEY=

# Interactsh (self-hosted, or an auth token for a hosted instance
# you control) - used by interactsh-client in
# interactsh-client
INTERACTSH_AUTH_TOKEN=

# GitHub personal access token - optional, raises your API rate
# limit for tools like github-subdomains and GitDorker
GITHUB_TOKEN=

# CyberStrike model providers. Set only the provider Hermes should delegate
# to; CyberStrike discovers these runtime-only variables automatically.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
